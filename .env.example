# Платформа ИИ-агентов (AIAgentBack): auth /agents /tasks /knowledge-base /procurement.
# НЕ agent-pochta (:8080). Должен быть TCP-доступен с машины, где запущен Vite.
#
# Агент поиска/оценки/заказа (procurement_logistics_agent, /agents/procurement-manager)
# требует локальный AIAgentBack с маршрутами:
#   POST .../cases/{id}/agent/run|resume  и  GET .../agent/status
# Офисный 192.168.1.157:5454 этих маршрутов НЕ имеет → 404 на «Запустить агента».
# Для закупок используйте локальный backend и этот фронт (обычно :5174), не Desktop agent_nd_front на :5173.
VITE_API_SERVER=http://127.0.0.1:8002
# В dev НЕ задавайте VITE_API_URL — фронт ходит на /api/v1 через Vite proxy (нет CORS при доступе по LAN IP).
# Для production-сборки можно указать полный URL:
# VITE_API_URL=http://127.0.0.1:8002/api/v1
VITE_API_PROXY=http://127.0.0.1:8002
# Офисный API (без agent/run): VITE_API_SERVER=http://192.168.1.157:5454
# Локальный API agent-pochta (scripts/run_api.py → :8080)
VITE_POCHTA_API_PROXY=http://127.0.0.1:8080
# Local/dev: весь UI без логина (mock superuser). На бэке нужен AUTH_DISABLED=true при ENVIRONMENT=dev|test.
# VITE_SKIP_AUTH=true
# Local/dev magic link: /auth/dev-login?redirect=/agents/procurement-manager
# На бэке нужен DEV_AUTO_LOGIN=true (ENVIRONMENT=dev|test). Без пароля — JWT для bypass-пользователя БД.
# VITE_DEV_AUTO_LOGIN=true
# Входящая почта без platform API (5454): mock-пользователь в шапке, без GET /auth/me
VITE_STANDALONE_INCOMING_MAIL=true
# Открытый маршрут /agents/incoming-mail (true по умолчанию в dev, если STANDALONE не задан)
VITE_INCOMING_MAIL_PUBLIC=true
VITE_ONEC_API_SERVER=http://192.168.0.247:8000
# В dev оставьте пустым: запросы пойдут через Vite proxy /onec-api/api/v1
VITE_ONEC_API_URL=
