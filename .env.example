# Платформа ИИ-агентов (agent_nd backend): auth /agents /tasks /knowledge-base.
# НЕ agent-pochta (:8080). Должен быть TCP-доступен с машины, где запущен Vite.
# По умолчанию — офисный сервер 192.168.1.157; если вы в другой подсети (напр. 192.168.2.x)
# или видите «http proxy error … ETIMEDOUT …:5454» — укажите актуальный хост или подключите VPN.
# Проверка: Test-NetConnection -ComputerName <host> -Port 5454  → TcpTestSucceeded : True
VITE_API_SERVER=http://192.168.1.157:5454
# В dev НЕ задавайте VITE_API_URL — фронт ходит на /api/v1 через Vite proxy (нет CORS при доступе по LAN IP).
# Для production-сборки можно указать полный URL:
# VITE_API_URL=http://192.168.1.157:5454/api/v1
VITE_API_PROXY=http://192.168.1.157:5454
# Локальный API agent-pochta (scripts/run_api.py → :8080)
VITE_POCHTA_API_PROXY=http://127.0.0.1:8080
# Local/dev: весь UI без логина (mock superuser). На бэке нужен AUTH_DISABLED=true при ENVIRONMENT=dev|test.
# VITE_SKIP_AUTH=true
# Входящая почта без platform API (5454): mock-пользователь в шапке, без GET /auth/me
VITE_STANDALONE_INCOMING_MAIL=true
# Открытый маршрут /agents/incoming-mail (true по умолчанию в dev, если STANDALONE не задан)
VITE_INCOMING_MAIL_PUBLIC=true
VITE_ONEC_API_SERVER=http://192.168.0.247:8000
# ESKD Agent backend (docker eskd-backend на :8080)
# На сервере 192.168.1.157 порт 8080 занят agent-pochta — укажите хост с eskd-backend
# (напр. WSL LAN http://192.168.2.120:8080 или отдельный порт после деплоя).
VITE_ESKD_API_PROXY=http://192.168.2.120:8080
# В dev НЕ задавайте VITE_ESKD_API_URL — превью и API идут через Vite proxy /eskd-api → :8080.
# Если задать пустую строку или VITE_API_URL, <img src> уйдёт на platform API :5454 и превью не загрузится.
# В dev оставьте пустым: запросы пойдут через Vite proxy /onec-api/api/v1
VITE_ONEC_API_URL=
