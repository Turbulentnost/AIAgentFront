# Хост backend на машине, где запущены uvicorn + Vite (LAN IP, не localhost для удалённых тестеров).
# Пример LAN-хоста Авион: http://192.168.2.225:5454
VITE_API_SERVER=http://192.168.2.225:5454
# В dev НЕ задавайте VITE_API_URL — фронт ходит на /api/v1 через Vite proxy (нет CORS при доступе по LAN IP).
# Vite proxy на сервере всё равно ходит на localhost:5454 — см. VITE_API_PROXY ниже.
# Для production-сборки:
# VITE_API_URL=http://192.168.2.225:5454/api/v1
VITE_API_PROXY=http://127.0.0.1:5454
# Локальный API agent-pochta (scripts/run_api.py → :8080)
VITE_POCHTA_API_PROXY=http://localhost:8080
VITE_ONEC_API_SERVER=http://192.168.0.247:8000
# В dev оставьте пустым: запросы пойдут через Vite proxy /onec-api/api/v1
VITE_ONEC_API_URL=
# WeChat-утилита (CONNECT.md): ws://IP_WeChat_ПК:8790 — настраивается в AIAgentBack/.env
# WECHAT_WS_URL=ws://192.168.5.241:8790
# WECHAT_JWT_SECRET=<JWT_SECRET из .env утилиты>
